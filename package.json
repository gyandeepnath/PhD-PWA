{
  "name": "visulab",
  "version": "2.1.0",
  "private": true,
  "description": "VisuLab \u2014 Visual Ergonomics Experiment PWA (reconstructed, scientifically refined source)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "tsx src/sim/runSimulation.ts",
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "fuzz": "tsx src/sim/runFuzz.ts",
    "stress": "tsx scripts/stress/adversarial.ts && tsx scripts/stress/pipeline.ts && tsx scripts/stress/statemachine.ts && tsx scripts/stress/metamorphic.ts && tsx scripts/stress/recovery.ts && tsx scripts/stress/components.ts",
    "icons": "node scripts/make-icons.mjs",
    "verify:export": "tsx scripts/verifyExport.ts",
    "verify:analysis": "node scripts/verifyAnalysis.mjs",
    "simulate:timing": "tsx scripts/simulateParticipant.ts",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "verify:corpus": "tsx scripts/verifyCorpus.ts",
    "verify:codebook": "tsx scripts/buildCodebook.ts",
    "verify": "npm run lint && tsc -b && npm run test && npm run verify:corpus && npm run verify:codebook && npm run verify:export && npm run verify:analysis",
    "package": "node scripts/package.mjs",
    "simulate:frontier": "tsx scripts/protocolFrontier.ts",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "synopsis:pptx": "node synopsis/build_pptx.cjs",
    "synopsis:docx": "node synopsis/build_docx.cjs synopsis/SYNOPSIS_AdtU.md synopsis/Synopsis_Gyandeep_Nath_AdtU.docx",
    "verify:bundle": "node scripts/verifyBundle.mjs",
    "postbuild": "node scripts/verifyBundle.mjs"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "0.4.1633559619",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "docx": "^9.7.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^1.6.0"
  }
}
